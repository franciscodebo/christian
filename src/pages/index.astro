---
import TaskManager from '../components/TaskManager.svelte';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>Task Manager</title>
  </head>
  <body>
    <div class="blob a"></div>
    <div class="blob b"></div>

    <main>
      <h1>Tasks</h1>
      <p class="subtitle">get things done</p>
      <TaskManager client:load />
    </main>

    <footer>
      <a href={`${base}/hello.html`}>hello, world →</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07060f;
    --surface: rgba(255, 255, 255, 0.05);
    --border: rgba(255, 255, 255, 0.1);
    --text: #f4f2ff;
    --muted: rgba(244, 242, 255, 0.55);
    --c1: #ff3cac;
    --c2: #784ba0;
    --c3: #2b86c5;
    --c4: #00f5d4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Space Grotesk', system-ui, sans-serif;
    overflow-x: hidden;
  }
  .blob {
    position: fixed;
    width: 60vmax;
    height: 60vmax;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.25;
    z-index: -1;
    animation: drift 20s ease-in-out infinite alternate;
  }
  .blob.a { background: var(--c1); top: -25vmax; left: -20vmax; }
  .blob.b { background: var(--c3); bottom: -30vmax; right: -20vmax; animation-delay: -10s; }
  @keyframes drift {
    to { transform: translate(12vmax, 8vmax) scale(1.15) rotate(30deg); }
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vh, 5rem) 16px 2rem;
  }
  h1 {
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(90deg, var(--c1), var(--c2), var(--c3), var(--c4), var(--c1));
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 8s linear infinite;
  }
  @keyframes shimmer { to { background-position: 300% 0; } }
  .subtitle {
    margin: 0.5rem 0 2rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--muted);
  }
  footer {
    text-align: center;
    padding: 2rem 16px 3rem;
  }
  footer a { color: var(--muted); text-decoration: none; font-size: 0.85rem; }
  footer a:hover { color: var(--c4); }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
